+// Native AA controls are deliberately separate from the picture-look controls.
+extern "C" __declspec(dllexport) void RexSmaaEnable(int enabled) {
+  using namespace rex::graphics::d3d12;
+  g_smaa_enabled.store(enabled != 0, std::memory_order_relaxed);
+  if (g_smaa_status.load(std::memory_order_relaxed) >= 0)
+    g_smaa_status.store(enabled ? 1 : 0, std::memory_order_relaxed);
+}
+extern "C" __declspec(dllexport) int RexSmaaStatus() {
+  using namespace rex::graphics::d3d12;
+  return g_smaa_status.load(std::memory_order_relaxed);
+}
