+
+// The optional Classic AA mod owns its preference and menu-bypass logic.
+// Resolve its small API after mods are loaded, when Display is first opened.
+bool ClassicAaAvailable() {
+  const HMODULE mod = GetModuleHandleW(L"ClassicAA.dll");
+  return mod && GetProcAddress(mod, "ClassicAAGetEnabled") &&
+         GetProcAddress(mod, "ClassicAASetEnabled");
+}
+int ClassicAaChoice() {
+  using Get = int (*)();
+  const HMODULE mod = GetModuleHandleW(L"ClassicAA.dll");
+  const auto get = mod ? reinterpret_cast<Get>(GetProcAddress(mod, "ClassicAAGetEnabled")) : nullptr;
+  return get && get() ? 1 : 0;
+}
+void ApplyClassicAaChoice(int choice) {
+  using Set = void (*)(int);
+  const HMODULE mod = GetModuleHandleW(L"ClassicAA.dll");
+  const auto set = mod ? reinterpret_cast<Set>(GetProcAddress(mod, "ClassicAASetEnabled")) : nullptr;
+  if (set) set(choice == 1 ? 1 : 0);
+}
 
