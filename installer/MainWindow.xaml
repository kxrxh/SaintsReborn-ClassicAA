<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Classic AA" Width="860" Height="720" MinWidth="760" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#111317" Foreground="#F1F2F4"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Window.Icon><DrawingImage><DrawingImage.Drawing><DrawingGroup>
    <GeometryDrawing Brush="#C8B4F8"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,32,32" RadiusX="7" RadiusY="7"/></GeometryDrawing.Geometry></GeometryDrawing>
    <GeometryDrawing Geometry="M 8,24 L 15,9 L 20,24 M 11,19 L 18,19 M 22,11 L 26,11">
      <GeometryDrawing.Pen><Pen Brush="#17121F" Thickness="2.4" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
    </GeometryDrawing>
  </DrawingGroup></DrawingImage.Drawing></DrawingImage></Window.Icon>
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#A2A8B4"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="9"/><Setter Property="Background" Value="#111317"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"
                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}"
                 Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#454B57" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          </Track>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="9"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#242830"/><Setter Property="Foreground" Value="#F1F2F4"/>
      <Setter Property="BorderBrush" Value="#3A404B"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#F1F2F4"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#191C22" BorderBrush="#2C3039" BorderThickness="0,0,0,1" Padding="30,22">
      <DockPanel LastChildFill="False">
        <Border Width="42" Height="42" Background="#C8B4F8" CornerRadius="10" DockPanel.Dock="Left" Margin="0,0,14,0">
          <Path Stroke="#17121F" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M 11,29 L 20,12 L 25,29 M 15,23 L 23,23 M 27,14 L 31,14"/>
        </Border>
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <TextBlock Text="Classic AA" FontSize="21" FontWeight="SemiBold"/>
          <TextBlock Text="SAINTS REBORN" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="AppVersion" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,18,0"/>
          <Button x:Name="CheckUpdates" Content="Check for updates" Padding="13,8" FontSize="12"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="32,28,32,24">
        <TextBlock Text="Manage Classic AA" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,9"/>
        <TextBlock Text="SMAA 1x High smooths jagged edges and keeps the original colors and lighting."
                   Foreground="{StaticResource Muted}" Margin="0,0,0,24"/>
        <Border Background="#191C22" BorderBrush="#30353F" BorderThickness="1" CornerRadius="8" Padding="19,16" Margin="0,0,0,26">
          <DockPanel>
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#8992A0" VerticalAlignment="Top" Margin="0,7,12,0" DockPanel.Dock="Left"/>
            <StackPanel>
              <TextBlock x:Name="InstalledStatus" Text="Choose your game folder" FontWeight="SemiBold" FontSize="15"/>
              <TextBlock x:Name="InstalledDetail" Text="The folder containing dist, build and project." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <Label Content="_Saints Reborn folder" Target="{Binding ElementName=GameFolder}" Foreground="#F1F2F4" Padding="0" FontWeight="SemiBold" Margin="0,0,0,9"/>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Background="#1B1E24" BorderBrush="#434956" BorderThickness="1" CornerRadius="6" Padding="12,10">
            <TextBox x:Name="GameFolder" Background="Transparent" Foreground="#F1F2F4" BorderThickness="0" CaretBrush="White"
                     VerticalContentAlignment="Center" AutomationProperties.Name="Saints Reborn folder"/>
          </Border>
          <Button x:Name="Browse" Grid.Column="1" Content="Browse…" Margin="10,0,0,0"/>
        </Grid>
        <TextBlock Text="Uses your existing source/build installation. Game files are built locally."
                   Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,19"/>
        <WrapPanel Margin="0,0,0,23">
          <TextBlock x:Name="SourceCheck" Margin="0,0,24,6" FontSize="12"/>
          <TextBlock x:Name="PowerShellCheck" Margin="0,0,24,6" FontSize="12"/>
          <TextBlock x:Name="GameCheck" Margin="0,0,0,6" FontSize="12"/>
        </WrapPanel>
        <Button x:Name="GetPowerShell" Content="Get PowerShell 7 ↗" HorizontalAlignment="Left" Margin="0,0,0,18" Visibility="Collapsed"/>
        <Border BorderBrush="#30353F" BorderThickness="0,1,0,0" Padding="0,18,0,0">
          <StackPanel>
            <TextBlock Text="After installation" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Text="Enable Classic AA in Whompay's Mod Loader, then choose SMAA High in Options → Display → Anti-aliasing."
                       Foreground="{StaticResource Muted}" FontSize="12"/>
          </StackPanel>
        </Border>
        <Expander x:Name="Activity" Header="Activity log" Foreground="{StaticResource Muted}" Margin="0,22,0,0">
          <TextBox x:Name="Log" IsReadOnly="True" Height="150" Background="#0D0F12" Foreground="#BDC4D0" BorderThickness="0"
                   FontFamily="Consolas" FontSize="11" Padding="12" Margin="0,9,0,0" TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Activity log"/>
        </Expander>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#191C22" BorderBrush="#30353F" BorderThickness="0,1,0,0" Padding="32,18">
      <StackPanel>
        <ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="#C8B4F8" Background="#30353F" Margin="0,0,0,14"/>
        <TextBlock x:Name="Message" Text="Ready when you are." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,14"/>
        <DockPanel LastChildFill="False">
          <Button x:Name="Install" DockPanel.Dock="Right" Content="Install Classic AA" Background="#C8B4F8" Foreground="#17121F" BorderBrush="#C8B4F8" FontWeight="SemiBold" MinWidth="176"/>
          <Button x:Name="Uninstall" DockPanel.Dock="Right" Content="Uninstall" Margin="0,0,10,0"/>
          <Button x:Name="OpenLog" DockPanel.Dock="Left" Content="Open full log" Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource Muted}" Padding="0,11"/>
          <Button x:Name="Releases" DockPanel.Dock="Left" Content="Releases ↗" Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource Muted}" Padding="0,11" Margin="20,0,0,0"/>
        </DockPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
